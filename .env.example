# ---------------------------------------------------------------------------
# DARUKAA.EARTH environment variables
#
# Copy to .env and fill in. NEVER commit .env — it is git-ignored.
# Only VITE_* values reach the browser; everything else is server-side only.
# ---------------------------------------------------------------------------

# --- Frontend --------------------------------------------------------------

# Address of the FastAPI service. When set, the app routes all project, site
# and analytics traffic through FastAPI. When empty, it falls back to the
# direct database path (useful for local work without a Python process).
VITE_API_BASE_URL=http://localhost:8000

# Mapbox public token (safe in the browser; restrict it by URL in Mapbox).
VITE_LOVABLE_CONNECTOR_MAPBOX_PUBLIC_TOKEN=

# Backend connection for the fallback transport (publishable values only).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- FastAPI service (backend/.env) ---------------------------------------

# PostgreSQL + PostGIS connection string. Server-side only — never expose it
# to the browser and never prefix it with VITE_.
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
DB_POOL_SIZE=5

# JWT verification. Use JWT_SECRET for symmetric (HS256) projects, or
# JWT_JWKS_URL for asymmetric signing keys (RS256/ES256). One of the two.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_AUDIENCE=authenticated
JWT_JWKS_URL=

# Auth server used by /api/auth/login and /api/auth/register.
AUTH_BASE_URL=https://<your-backend-host>/auth/v1
AUTH_ANON_KEY=

# Browser origins allowed to call the API (comma-separated, no wildcard in prod).
CORS_ORIGINS=http://localhost:8080
ENVIRONMENT=development

# Server-side backend keys (never VITE_-prefixed, never sent to the browser).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
